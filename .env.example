DJANGO_SECRET_KEY=django-insecure-sim-akreditasi-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# Domain kustom tambahan (mis. domain Vercel), dipisah koma.
# Wajib diisi kalau menambah domain baru, kalau tidak request kena 400 DisallowedHost.
DJANGO_EXTRA_ALLOWED_HOSTS=
# Biarkan kosong untuk pakai SQLite lokal, isi connection string Postgres saat di Render/Cloud:
DATABASE_URL=

# Supabase Storage Credential
SUPABASE_URL=https://gwaeuzbbdawbekrmrvfd.supabase.co
SUPABASE_KEY=sb_publishable_Kij2JQk2QnGrLmic-vBQ2A_WR7OnawQ
SUPABASE_BUCKET=bukti-akreditasi

# Arima Human Capital private storage. Bucket MUST remain private.
# Service key belongs in deployment secrets only; never expose it to browsers/logs.
# Use a Supabase service_role key here, NOT the publishable/anon key above.
HC_PRIVATE_STORAGE_SERVICE_KEY=
HC_PRIVATE_STORAGE_BUCKET=human-capital-private

# Optional: local .env loading is automatic; platform variables always win.

# Wajib di produksi: origin publik kanonik untuk tautan aktivasi akun.
PUBLIC_BASE_URL=https://arima.example.org

# ── GitHub Actions: HC Reminders ──────────────────────────────────────────
# Workflow .github/workflows/hc-reminders.yml menjalankan
# `manage.py hc_reminders` setiap hari 01:00 WIB. Tambahkan secret berikut di
# GitHub (Settings → Secrets and variables → Actions → New repository secret):
#   HC_REMINDERS_DATABASE_URL — connection string Postgres produksi.
#     WAJIB memakai Supabase Session pooler (port 5432), bukan direct connection
#     'db.<ref>.supabase.co' — host itu hanya punya record IPv6, sedangkan runner
#     GitHub Actions hanya IPv4. Bentuknya:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#     Ambil dari: Supabase Dashboard → Project Settings → Database →
#     Connection string → Session pooler.
# DJANGO_SECRET_KEY tidak diperlukan: command ini tidak membuat HTTP request
# maupun login, dan Django membuat kunci acak bila env kosong.
# Job bisa dijalankan manual dari tab Actions → HC Reminders → Run workflow,
# dengan pilihan dry run untuk mencoba tanpa menulis ke database.
